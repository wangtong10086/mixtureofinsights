---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Post from '../../../components/Post.astro';
import { langOf, slugOf, localUrl, seriesUrl, seriesName } from '../../../i18n';
import { byOrder, type Post as BlogPost } from '../../../lib/posts';

export async function getStaticPaths() {
  const all = await getCollection('blog');
  const mine = all.filter((p) => langOf(p.id) === 'zh');
  return mine.map((post) => {
    let prev: BlogPost | null = null, next: BlogPost | null = null;
    if (post.data.series) {
      const sib = mine.filter((p) => p.data.series === post.data.series).sort(byOrder);
      const i = sib.findIndex((p) => p.id === post.id);
      prev = sib[i - 1] ?? null; next = sib[i + 1] ?? null;
    }
    const hasTranslation = all.some((p) => langOf(p.id) === 'en' && slugOf(p.id) === slugOf(post.id));
    return { params: { slug: slugOf(post.id) }, props: { post, prev, next, hasTranslation } };
  });
}
const { post, prev, next, hasTranslation } = Astro.props;
---
<Base title={post.data.title} description={post.data.description} image={`/og/${slugOf(post.id)}.jpg`} type="article" date={post.data.date} updatedAt={post.data.updatedAt} breadcrumbs={[{name:'文章',url:localUrl('zh','/')},...(post.data.series?[{name:seriesName(post.data.series,'zh')!,url:seriesUrl('zh',post.data.series)}]:[]),{name:post.data.title,url:Astro.url.pathname}]} lang="zh" hasTranslation={hasTranslation}>
  <Post post={post} prev={prev} next={next} lang="zh" />
</Base>
