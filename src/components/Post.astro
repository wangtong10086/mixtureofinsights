---
import { render } from 'astro:content';
import Comments from './Comments.astro';
import { t, slugOf, postUrl, seriesName, seriesUrl, type Lang } from '../i18n';
import { formatDate, type Post } from '../lib/posts';
interface Props { post: Post; prev: Post | null; next: Post | null; lang: Lang; }
const { post, prev, next, lang } = Astro.props;
const tr = t(lang);
const seriesLabel = seriesName(post.data.series, lang);
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const slug = slugOf(post.id);
const cover = `/og/${slug}.jpg`;
---
<div class="reading-progress" aria-hidden="true"><span id="rp"></span></div>

<article class="wrap article">
  {post.data.series && <a class="series-label" href={seriesUrl(lang, post.data.series)}>{seriesLabel}</a>}
  <div class="meta"><time datetime={post.data.date.toISOString().slice(0, 10)}>{formatDate(post.data.date, lang, 'long')}</time>{post.data.reading ? ` · ${post.data.reading}` : ''}</div>
  <h1>{post.data.title}</h1>

  {post.data.showCover && <img class="cover" src={cover} alt={`${tr('post.coverAlt')} “${post.data.title}”`} width="1024" height="1024" loading="lazy" decoding="async" />}

  {toc.length >= 3 && (
    <details class="toc">
      <summary>{tr('post.contents')}</summary>
      <ol>
        {toc.map((h) => (
          <li class={h.depth === 3 ? 'h3' : 'h2'}><a href={`#${h.slug}`}>{h.text}</a></li>
        ))}
      </ol>
    </details>
  )}

  <div class="prose" id="article-body"><Content /></div>
  {post.data.tags.length > 0 && <div class="tags">{post.data.tags.map((tag) => <span>{tag}</span>)}</div>}

  {(prev || next) && (
    <nav class="post-nav" aria-label={tr('series.contents')}>
      {prev ? <a href={postUrl(lang, slugOf(prev.id))}><span class="label">{tr('post.prev')}</span>{prev.data.title}</a> : <span></span>}
      {next ? <a href={postUrl(lang, slugOf(next.id))} style="text-align:right"><span class="label">{tr('post.next')}</span>{next.data.title}</a> : <span></span>}
    </nav>
  )}

  <Comments lang={lang} />
</article>

<script is:inline>
  (function () {
    var bar = document.getElementById('rp'); var art = document.getElementById('article-body');
    if (!bar || !art) return;
    function upd() {
      var rect = art.getBoundingClientRect();
      var total = rect.height - window.innerHeight;
      var progress = total > 0 ? -rect.top / total : (rect.bottom <= window.innerHeight ? 1 : 0);
      bar.style.width = Math.max(0, Math.min(1, progress)) * 100 + '%';
    }
    document.addEventListener('scroll', upd, { passive: true }); window.addEventListener('resize', upd);
    new ResizeObserver(upd).observe(art); upd();
  })();
</script>
