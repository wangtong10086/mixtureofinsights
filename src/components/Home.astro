---
import { t, seriesName, seriesUrl, localUrl, type Lang } from '../i18n';
import { postsFor, groupsFor } from '../lib/posts';
import PostList from './PostList.astro';
const { lang = 'en' } = Astro.props as { lang?: Lang };
const tr = t(lang);
const mine = await postsFor(lang);
const groups = groupsFor(mine);
---
<div class="wrap index-wrap">
  <header class="home-intro">
    <h1>{tr('home.title')}</h1>
    <p>{tr('hero.desc')}</p>
  </header>
  <div class="home-columns">
    <section aria-labelledby="recent-heading">
      <div class="index-heading"><h2 id="recent-heading">{tr('home.recent')}</h2><span>{mine.length} {tr('posts.count')}</span></div>
      <PostList posts={mine.slice(0, 6)} lang={lang} />
      <a class="all-posts" href={localUrl(lang, '/archive/')}>{tr('home.all')} <span aria-hidden="true">→</span></a>
    </section>
    <aside class="series-index" aria-labelledby="series-heading">
      <div class="index-heading"><h2 id="series-heading">{tr('section.series')}</h2></div>
      <ul>
        {groups.map((group) => (
          <li><a href={seriesUrl(lang, group.key)}>{seriesName(group.key, lang)}<span>{group.posts.length} {tr('posts.count')}</span></a></li>
        ))}
      </ul>
      <a class="rss-link" href={localUrl(lang, '/rss.xml')}>RSS <span aria-hidden="true">↗</span></a>
    </aside>
  </div>
</div>

